# PSA Nexus — Environment Variables
# Copy to .env and fill in values. Only API keys are required.

# Primary LLM provider API keys (anthropic is default)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: additional providers
GOOGLE_API_KEY=...
DEEPSEEK_API_KEY=...

# Optional: local providers (Ollama, vLLM, LM Studio)
# OLLAMA_BASE_URL=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8080
# LMSTUDIO_BASE_URL=http://localhost:1234

# LangSmith tracing (optional, for observability)
# The platform is called LangSmith but the SDK env vars use the LANGCHAIN_ prefix.
# Get your key at https://smith.langchain.com/settings → API Keys
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_...   # this IS a LangSmith key (LANGCHAIN_ prefix is SDK convention)
# LANGCHAIN_PROJECT=psa-nexus

# Admin panel (optional, defaults shown)
# ADMIN_USER=admin
# ADMIN_PASS=admin123
# ADMIN_SESSION_SECRET=change-me-in-production

# CORS (optional, default allows same-origin)
# CORS_ORIGINS=http://localhost:8000
